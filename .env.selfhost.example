# Retired legacy template.
#
# Sajda's supported production path is Neon Postgres through Vercel Functions,
# with Neon Auth for accounts. See docs/NEON-VERCEL.md. Do not add a database
# URL or database password to VITE_ variables.
NAME_QUEST_WEB_BIND_ADDRESS=127.0.0.1
NAME_QUEST_WEB_PORT=8080

# Optional evidence-first market context. Only the fixed, attributed NameBio
# aggregate TLDStats connector can be enabled; URLs and individual-sale API
# access are intentionally not configurable here.
# SAJDA_FACT_SIGNAL_SOURCES=namebio-tldstats
