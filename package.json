{
  "name": "name-quest-engine",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=11"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "lodash": "^4.18.1",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "serve:qa": "tsx scripts/serve-vercel-local.ts",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "check:language": "node scripts/check-language-contracts.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:live-search": "node --import tsx scripts/probe-search-quality.mjs",
    "db:plan": "node scripts/migrate-neon.mjs --plan",
    "db:check": "node --env-file-if-exists=.env.local scripts/migrate-neon.mjs --check",
    "db:apply": "node --env-file-if-exists=.env.local scripts/migrate-neon.mjs --apply",
    "dev": "vite",
    "dev:native": "vite --config vite.native.config.ts",
    "build:native": "node scripts/build-native.mjs",
    "generate:native-assets": "node scripts/generate-native-assets.mjs",
    "sync:ios": "cap sync ios",
    "open:ios": "cap open ios",
    "start:local": "npm run build:local && npm run serve:full",
    "serve:full": "node --env-file-if-exists=.env.local infra/local-server/full-app-server.mjs",
    "start:local-search": "node infra/local-server/server.mjs",
    "check:local": "node infra/local-server/check-page.mjs",
    "build": "node scripts/build-static.mjs",
    "build:local": "node scripts/build-static.mjs --local-test",
    "generate:seo": "node scripts/generate-seo-static.mjs",
    "check:seo": "node scripts/check-seo-static.mjs",
    "check:seo-policy": "node scripts/check-seo-policy.mjs",
    "check:seo-local": "node scripts/check-local-seo.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:legacy:supabase-functions": "deno task test:functions",
    "check:legacy:supabase-functions": "deno task check:functions",
    "test:functions": "npm run test:legacy:supabase-functions",
    "check:functions": "npm run check:legacy:supabase-functions",
    "check:vercel": "node scripts/check-vercel-types.mjs",
    "check:neon": "node scripts/check-neon-boundary.mjs",
    "check:neon-build": "node scripts/check-neon-build.mjs",
    "check:node": "node scripts/check-node-syntax.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:language && npm run check:seo-policy && npm run check:neon && npm run check:node && npm run check:vercel && npm test && npm run check:ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@vercel/functions": "3.9.7",
    "@vercel/oidc": "3.8.5",
    "better-auth": "1.7.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.25.0",
    "jose": "6.2.5",
    "lucide-react": "^0.462.0",
    "pg": "8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "robots-parser": "3.0.1",
    "sonner": "^1.7.4",
    "stripe": "22.6.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tldts": "7.4.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@eslint/js": "^9.32.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "deno": "2.9.5",
    "esbuild": "0.28.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.26",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
