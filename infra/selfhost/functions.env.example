# Copy to the official self-hosted Supabase directory as .env.functions.
# Do not commit the real file. SUPABASE_URL is internal to the Docker network.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-self-hosted-service-role-key
JOB_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Comma-separated browser origins; no wildcard in production.
ALLOWED_ORIGINS=https://namequest.example.internal

# Optional: point at a locally mirrored IANA bootstrap document when egress is
# prohibited. RDAP itself still needs an approved registry/registrar channel.
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
