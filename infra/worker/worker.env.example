# Keep this file outside version control after assigning real values.
# The worker runs beside the official self-hosted Supabase Compose stack.
SUPABASE_INTERNAL_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-self-hosted-service-role-key
JOB_SECRET=replace-with-a-long-random-secret
WORKER_POLL_MS=15000

# Set true only after the nightly job has passed manual smoke tests.
ENABLE_SCHEDULED_JOBS=false
NIGHTLY_SCAN_HOUR=2
