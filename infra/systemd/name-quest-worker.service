[Unit]
Description=Sajda local scan worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=namequest
Group=namequest
WorkingDirectory=/opt/name-quest
EnvironmentFile=/etc/name-quest/worker.env
ExecStart=/usr/bin/node /opt/name-quest/infra/worker/worker.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/name-quest

[Install]
WantedBy=multi-user.target
